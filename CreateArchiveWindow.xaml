<Window x:Class="ArchiverApp.CreateArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Створити новий архів" Height="360" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Назва архіву:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Text="Формат:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <ComboBox x:Name="FormatComboBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="0,0,0,10">
            <ComboBoxItem Content=".zip"/>
            <ComboBoxItem Content=".rar"/>
            <ComboBoxItem Content=".tar.gz"/>
            <ComboBoxItem Content=".ace"/>
        </ComboBox>

        <TextBlock Text="Рівень стиснення (1-9):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="CompressionTextBox" Grid.Row="2" Grid.Column="1" Text="5" Margin="0,0,0,10"/>

        <TextBlock Text="Файли:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <Button Content="Обрати файли..." Grid.Row="3" Grid.Column="1" Height="25" Margin="0,0,0,10" Click="SelectFiles_Click"/>

        <ListBox x:Name="FilesListBox" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Скасувати" Width="80" Height="28" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Зберегти" Width="80" Height="28" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>